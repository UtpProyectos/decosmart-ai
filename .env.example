# --- General ---
# development | production | test
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
# URL pública del backend (para webhook y media)
PUBLIC_BASE_URL=http://localhost:8000

# --- Base de datos (Supabase Postgres) ---
# Supabase > Connect > Session pooler (puerto 5432). Mantener el prefijo postgresql+psycopg:// y ?sslmode=require
# Alternativa local: postgresql+psycopg://decosmart:decosmart@db:5432/decosmart + `docker compose --profile localdb up`
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# alembic upgrade head al iniciar
AUTO_MIGRATE=true
# seed idempotente al iniciar si no hay productos
AUTO_SEED=true

# --- Seguridad ---
ADMIN_API_KEY=change-me-admin-key
RATE_LIMIT_PER_MIN=60

# --- IA ---
# mock | live
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
# vacío = no se envía el parámetro
OPENAI_REASONING_EFFORT=low
OPENAI_CHAT_MAX_OUTPUT_TOKENS=400
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# 1024x1024 | 1536x1024 | 1024x1536 | auto
IMAGE_SIZE=1024x1024
# low | medium | high
IMAGE_QUALITY=low
SIMULATION_USE_PRODUCT_REFERENCE=true
# moderar texto libre de placement_hint (endpoint gratuito)
OPENAI_MODERATION=true
AGENT_HISTORY_TURNS=6
AGENT_MAX_TOOL_ROUNDS=4

# --- Presupuesto y cuotas ---
BUDGET_USD_LIMIT=3.50
BUDGET_WARN_PCT=80
MAX_SIMULATIONS_PER_CUSTOMER=2
MAX_SIMULATIONS_PER_DAY=15
MAX_LLM_MESSAGES_PER_CUSTOMER_PER_DAY=40

# --- Imágenes ---
INPUT_MAX_SIDE=1280
INPUT_JPEG_QUALITY=85
OUTPUT_MAX_SIDE=768
# JPEG | WEBP
OUTPUT_FORMAT=JPEG
OUTPUT_QUALITY=82
OUTPUT_TARGET_MAX_KB=400
MAX_UPLOAD_MB=10
PHOTO_RETENTION_DAYS=7
STORE_FULL_OUTPUT=false

# --- Storage (Supabase Storage, API compatible S3) ---
# s3 = Supabase Storage | local = disco (solo desarrollo)
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=/app/storage
# Supabase > Storage > S3 Connection > Endpoint
S3_ENDPOINT_URL=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# Bucket PRIVADO creado en Supabase > Storage
S3_BUCKET=decosmart
# Supabase > Storage > S3 Connection > New access key
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supabase > Storage > S3 Connection > Region
S3_REGION=us-east-1
# No se usa (el catálogo lo sirve el backend en /static/products)
S3_PUBLIC_BASE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DecoSmartBot
# polling | webhook | disabled
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# chat que recibe notificaciones
ADMIN_TELEGRAM_CHAT_ID=

# --- Automatización ---
LOW_STOCK_THRESHOLD=5
QUOTE_VALIDITY_DAYS=7
# hora local America/Lima
DAILY_SUMMARY_HOUR=20
TIMEZONE=America/Lima
SCHEDULER_ENABLED=true
# opcional: si existe, se reenvían eventos
N8N_WEBHOOK_URL=

# --- Frontend (build time) ---
VITE_API_URL=http://localhost:8000
VITE_TELEGRAM_BOT_URL=https://t.me/DecoSmartBot

# --- Dashboard ---
DASHBOARD_API_URL=http://backend:8000
# Debe ser IGUAL a ADMIN_API_KEY (el dashboard la usa para leer /admin/*). En docker compose se copia sola.
DASHBOARD_ADMIN_KEY=change-me-admin-key
# si se define, el dashboard pide contraseña
DASHBOARD_PASSWORD=
